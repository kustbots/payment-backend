# Mongo
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=payments-app
MONGO_DB_NAME=payments_app

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# OxaPay
OXAPAY_API_KEY=
OXAPAY_API_BASE=https://api.oxapay.com
OXAPAY_CALLBACK_URL=https://your-domain.example/api/payments/oxapay/webhook

# External Rebate Claimer activation API
CLAIMER_API_URL=https://your-code-claimer-api.example.com
CLAIMER_ADMIN_TOKEN=
API_CLAIMER_AUTH_URL=https://your-api-claimer-api.example.com

# Heroku-style deployer pool for the API Claimer product (JSON array)
API_CLAIMER_DEPLOYERS=[{"deploy_id":1,"url":"https://api-claimer-deploy-1-z-4d0233814947.herokuapp.com","token":"","limit":100},{"deploy_id":2,"url":"https://api-claimer-deploy-2-zs-95da69176319.herokuapp.com","token":"","limit":100},{"deploy_id":3,"url":"https://api-claimer-deploy3-6c-30b172c76914.herokuapp.com","token":"","limit":100},{"deploy_id":4,"url":"https://api-claimer-deploy4-a-a07a02c5887f.herokuapp.com","token":"","limit":100}]
API_CLAIMER_MIRROR_SITE=example.com
API_CLAIMER_REGION=eu

# Refunds / payments
REFUND_RATE_CLAIMER_PER_HOUR=0.0
REFUND_RATE_API_CLAIMER_PER_HOUR=0.0
PAYMENT_TIMEOUT_SECONDS=900
POLL_INTERVAL_SECONDS=30

# App
ENV=development
ADMIN_BOOTSTRAP_EMAIL=

# Telegram login (deep-link + bot /start based auth -- create a bot via
# @BotFather to get the token/username; TELEGRAM_WEBHOOK_BASE_URL is this
# app's own public URL, e.g. https://your-app.herokuapp.com)
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_LOGIN_TIMEOUT_SECONDS=600

# CORS -- comma-separated list of allowed frontend origins (no trailing slash),
# e.g. https://your-frontend.workers.dev. Defaults to "*" (any origin).
CORS_ALLOWED_ORIGINS=*
